# Little Snoots — production (cPanel shared hosting)
# Copy to .env on the server, fill in the values, then run: php artisan key:generate
#
# NEVER commit the real .env, and never place it inside the web root.

APP_NAME="Little Snoots"
APP_ENV=production
APP_KEY=                                  # leave blank; `php artisan key:generate` fills it
APP_DEBUG=false                           # must stay false — true leaks creds on any error page
APP_URL=https://www.little-snoots.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily                           # daily so logs rotate instead of growing forever
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                           # production: errors only

# cPanel prefixes both names, e.g. cpaneluser_littlesnoots
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CPANELUSER_littlesnoots
DB_USERNAME=CPANELUSER_littlesnoots
DB_PASSWORD=PUT_A_STRONG_PASSWORD_HERE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true                # HTTPS-only cookies; safe once AutoSSL is on

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail is unused today (no mailables in the app). When you add contact or booking
# emails, switch MAIL_MAILER to smtp and fill these from cPanel > Email Accounts.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@little-snoots.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
